[flake8]
max-line-length = 120
exclude =
    __pycache__,
    .git,
    data,
    exports,
    .workbuddy,
    *.pyc
ignore = E203,W503,E501
per-file-ignores =
    __init__.py:F401,F403
    */models/*.py:E501
    main.py:E402
    ui/main_gui.py:E402
max-complexity = 15
show-source = True
statistics = True
